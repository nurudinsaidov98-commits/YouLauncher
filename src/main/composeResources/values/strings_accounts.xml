    <string name="accounts_notice_title">About these accounts</string>
    <string name="accounts_notice_body">YouLauncher supports offline and Ely.by accounts only. They do not work on official servers and Realms, which require a licensed Microsoft account. They do work in single player, on LAN and on servers with Ely.by or offline mode enabled.</string>
    <string name="accounts_ely_about">Ely.by is an independent skin and authentication service. YouLauncher talks to authserver.ely.by and adds authlib-injector so skins work in the game.</string>
    <string name="accounts_ely_register">Create an Ely.by account</string>

    <string name="offline_title">Offline account</string>
    <string name="offline_body">Choose a nickname. The UUID is derived from it, so the same nickname always gets the same UUID.</string>
