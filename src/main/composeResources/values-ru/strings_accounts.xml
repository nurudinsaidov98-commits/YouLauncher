    <string name="accounts_remove">Удалить аккаунт</string>
    <string name="accounts_remove_title">Удалить «%1$s»?</string>
    <string name="accounts_remove_body">Аккаунт будет удалён из YouLauncher. Для Ely.by сессия закрывается, а токен удаляется из диспетчера учётных данных Windows.</string>
    <string name="accounts_reauth">Войти заново</string>
